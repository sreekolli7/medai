# Copy to .env.local and fill in from Supabase dashboard > Project Settings > API Keys.
# Only public values go here. They ship to the browser.
# Never put the service role key, Anthropic key, Voyage key, or Stripe secret here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key both work.
VITE_SUPABASE_PUBLISHABLE_KEY=
